{
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "model_backend": "combined",
  "proto_stream": true,
  "proto_rank_loss": 0.0,
  "train_aux": ["nctti_en_scored.tsv"],
  "max_context_length": 256,
  "dropout": 0.3,

  "freeze_epochs": 30,
  "lora_epochs": 0,
  "lora_targets": [],
  "lora_rank": 0,

  "batch_size": 64,
  "accum_steps": 1,
  "num_workers": 0,
  "head_lr": 3e-4,
  "encoder_lr": 0.0,
  "embedding_lr": 0.0,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "amp_init_scale": 1024.0,
  "amp_growth_interval": 256,
  "patience": 6,
  "ema_decay": 0.999,
  "ccc_weight": 0.6,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "use_label_std": true,
  "test_size": 0.2,
  "seed": 42
}
