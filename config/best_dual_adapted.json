{
  "mode": "train80",
  "backbone": "checkpoints/prefix_mlm_adapted",
  "model_backend": "combined",
  "target_prefix": true,
  "prefix_readout": "prefix",
  "max_context_length": 256,
  "dropout": 0.2,
  "freeze_epochs": 10,
  "lora_epochs": 15,
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_from_layer": 18,
  "lora_dropout": 0.2,
  "batch_size": 64,
  "accum_steps": 1,
  "num_workers": 2,
  "head_lr": 1e-4,
  "encoder_lr": 2.5e-5,
  "embedding_lr": 0.0,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "amp_init_scale": 1024.0,
  "amp_growth_interval": 256,
  "patience": 5,
  "ema_decay": 0.999,
  "ccc_weight": 0.6,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "lambda_rank": 0,
  "rank_margin": 0.5,
  "rank_margin_mode": "clamp",
  "use_label_std": true,
  "test_size": 0.2,
  "seed": 42
