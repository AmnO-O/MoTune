{
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "max_context_length": 256,

  "mlm_epochs": 5,
  "mlm_lr": 5e-5,
  "mlm_mask_prob": 0.8,
  "mlm_from_layer": 18,
  "mlm_output_dir": "checkpoints/prefix_mlm_adapted",

  "mlm_batch_size": 32,

  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.2,
  "lora_targets": ["Wqkv", "Wo"],

  "batch_size": 64,
  "accum_steps": 1,
  "num_workers": 2,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "amp_init_scale": 1024.0,
  "amp_growth_interval": 256,
  "seed": 42
}
