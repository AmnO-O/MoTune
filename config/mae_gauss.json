{
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "max_context_length": 256,
  "gauss_dedicated": true,
  "gauss_ctx_mod": [19],
  "gauss_ctx_head": [20],
  "gauss_ctx_pv": [21, 22],
  "freeze_epochs": 3,
  "lora_epochs": 8,
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_from_layer": 18,
  "batch_size": 32,
  "accum_steps": 1,
  "num_workers": 0,
  "head_lr": 2e-4,
  "encoder_lr": 8e-6,
  "embedding_lr": 0.0,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "patience": 4,
  "ccc_weight": 0.7,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "lambda_rank": 0.5,
  "rank_margin": 0.5,
  "use_label_std": true,
  "test_size": 0.2,
  "seed": 42
}
